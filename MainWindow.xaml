<Window x:Class="HyperDL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperDL Download Manager"
        Height="760"
        Width="1080"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="6"
                   Margin="0,0,0,16"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="HyperDL Download Manager" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,0,5"
                   Text="URL:" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,0,0,5"
                   Text="連線數:" />
        <Button x:Name="DeleteRecordButton"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,6,4"
                Padding="8,2"
                Content="刪除紀錄"
                Click="DeleteRecord_Click" />
        <Button x:Name="OpenFolderButton"
                Grid.Row="1"
                Grid.Column="3"
                Margin="0,0,6,4"
                Padding="8,2"
                Content="開啟下載資料夾"
                Click="OpenFolder_Click" />
        <Button x:Name="SettingsToggleButton"
                Grid.Row="1"
                Grid.Column="4"
                Margin="0,0,6,4"
                Padding="8,2"
                Content="設定"
                Click="ToggleSettings_Click" />
        <TextBox x:Name="UrlTextBox"
                 Grid.Row="2"
                 Grid.Column="0"
                 Height="32"
                 Margin="0,0,10,14"
                 VerticalContentAlignment="Center"
                 ToolTip="輸入直接下載檔案的 HTTP 或 HTTPS 網址" />
        <ComboBox x:Name="ConnectionCountComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Height="32"
                  Width="78"
                  Margin="0,0,8,14"
                  SelectedIndex="0"
                  SelectedValuePath="Tag">
            <ComboBoxItem Content="Auto" Tag="0" />
            <ComboBoxItem Content="1" Tag="1" />
            <ComboBoxItem Content="2" Tag="2" />
            <ComboBoxItem Content="4" Tag="4" />
            <ComboBoxItem Content="8" Tag="8" />
            <ComboBoxItem Content="16" Tag="16" />
            <ComboBoxItem Content="32" Tag="32" />
            <ComboBoxItem Content="64" Tag="64" />
        </ComboBox>
        <Button x:Name="StartDownloadButton"
                Grid.Row="2"
                Grid.Column="2"
                Height="32"
                Padding="14,0"
                Content="Start Download"
                Click="StartDownload_Click" />
        <Button x:Name="PauseDownloadButton"
                Grid.Row="2"
                Grid.Column="3"
                Height="32"
                Margin="8,0,0,14"
                Padding="12,0"
                Content="暫停"
                IsEnabled="False"
                Click="PauseDownload_Click" />
        <Button x:Name="ResumeDownloadButton"
                Grid.Row="2"
                Grid.Column="4"
                Height="32"
                Margin="8,0,0,14"
                Padding="12,0"
                Content="繼續"
                IsEnabled="False"
                Click="ResumeDownload_Click" />
        <Button x:Name="CancelDownloadButton"
                Grid.Row="2"
                Grid.Column="5"
                Height="32"
                Margin="8,0,0,14"
                Padding="14,0"
                Content="Cancel"
                IsEnabled="False"
                Click="CancelDownload_Click" />

        <TextBlock x:Name="FileTextBlock"
                   Grid.Row="3"
                   Grid.ColumnSpan="6"
                   Margin="0,0,0,10"
                   Text="File: -"
                   TextWrapping="Wrap" />

        <GroupBox Grid.Row="4"
                  Grid.ColumnSpan="6"
                  Margin="0,0,0,10"
                  Header="伺服器資訊">
            <StackPanel Margin="8">
                <TextBlock x:Name="ServerTextBlock"
                           Margin="0,0,0,4"
                           Text="伺服器：尚未探測" />
                <TextBlock x:Name="FileSizeTextBlock"
                           Margin="0,0,0,4"
                           Text="檔案大小：未知" />
                <TextBlock x:Name="RangeSupportTextBlock"
                           Margin="0,0,0,4"
                           Text="Range：未知" />
                <TextBlock x:Name="DownloadModeTextBlock"
                           Text="下載模式：單連線下載" />
                <TextBlock x:Name="SegmentStatusTextBlock"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="Segment：尚未開始" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="6"
                    Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,5">
                <TextBlock Text="Progress:" />
                <TextBlock x:Name="PercentageTextBlock"
                           Margin="6,0,0,0"
                           Text="0%" />
            </DockPanel>
            <ProgressBar x:Name="DownloadProgressBar"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
        </StackPanel>

        <TextBlock x:Name="DownloadedTextBlock"
                   Grid.Row="6"
                   Grid.ColumnSpan="6"
                   Margin="0,0,0,6"
                   Text="Downloaded: 0 B / total unknown" />
        <TextBlock x:Name="SpeedTextBlock"
                   Grid.Row="7"
                   Grid.ColumnSpan="6"
                   Margin="0,0,0,6"
                   Text="Speed: 0 B/s" />
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="8"
                   Grid.ColumnSpan="6"
                   VerticalAlignment="Top"
                   Text="Status: Enter a file URL to begin."
                   TextWrapping="Wrap" />
        <Expander x:Name="SettingsExpander"
                   Grid.Row="9"
                   Grid.ColumnSpan="6"
                   Margin="0,8,0,0"
                   Header="設定">
            <StackPanel Orientation="Horizontal" Margin="8">
                <TextBlock VerticalAlignment="Center" Text="預設下載資料夾：" />
                <TextBox x:Name="SettingsDownloadDirectoryTextBox"
                         Width="270"
                         Margin="6,0,12,0"
                         VerticalContentAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Text="最大同時下載：" />
                <TextBox x:Name="MaximumConcurrentTextBox"
                         Width="40"
                         Margin="6,0,12,0"
                         VerticalContentAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Text="全域連線上限：" />
                <TextBox x:Name="GlobalConnectionLimitTextBox"
                         Width="40"
                         Margin="6,0,12,0"
                         VerticalContentAlignment="Center" />
                <CheckBox x:Name="LowRamModeCheckBox"
                          VerticalAlignment="Center"
                          Content="Low RAM 模式"
                          Margin="0,0,12,0" />
                <Button Content="儲存設定"
                        Padding="10,3"
                        Click="SaveSettings_Click" />
            </StackPanel>
        </Expander>
        <DataGrid x:Name="DownloadListDataGrid"
                  Grid.Row="10"
                  Grid.ColumnSpan="6"
                  Margin="0,8,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DownloadList_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="檔名" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="*" />
                <DataGridTextColumn Header="進度" Binding="{Binding Progress}" Width="*" />
                <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="*" />
                <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="*" />
                <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="連線數" Binding="{Binding ConnectionCount}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
