<Window x:Class="HyperDL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HyperDL.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Loc AppTitle}"
        Width="1180"
        Height="800"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="TaskbarProgress" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#E7ECF3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#E7ECF3" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>

        <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Recoverable">
                    <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailsContent" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="46"
                    Height="46"
                    CornerRadius="12"
                    Background="{StaticResource AccentBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="H"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc AppTitle}" Style="{StaticResource HeaderTitle}" />
                <TextBlock Text="{loc:Loc AppSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="LanguageComboBox"
                          Width="150"
                          Height="34"
                          Margin="0,0,8,0"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Tag="System" Content="{loc:Loc LanguageSystem}" />
                    <ComboBoxItem Tag="English" Content="{loc:Loc LanguageEnglish}" />
                    <ComboBoxItem Tag="TraditionalChinese" Content="{loc:Loc LanguageTraditionalChinese}" />
                </ComboBox>
                <Button Content="{loc:Loc SettingsButton}"
                        Style="{StaticResource ToolButton}"
                        ToolTip="{loc:Loc ToolTipSettings}"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <!-- URL input -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="2,0,12,0">
                    <TextBlock Text="{loc:Loc AddUrlWatermark}"
                               Foreground="{StaticResource SubtleBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UrlTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="UrlTextBox"
                             Style="{StaticResource InputBox}"
                             FontSize="14"
                             KeyDown="UrlTextBox_KeyDown" />
                </Grid>
                <Button Grid.Column="1"
                        Content="{loc:Loc AddButton}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="{loc:Loc ToolTipAdd}"
                        Click="AddButton_Click" />
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button x:Name="PauseButton" Content="{loc:Loc PauseButton}" Style="{StaticResource ToolButton}" Click="PauseButton_Click" />
                <Button x:Name="ResumeButton" Content="{loc:Loc ResumeButton}" Style="{StaticResource ToolButton}" Click="ResumeButton_Click" />
                <Button x:Name="CancelButton" Content="{loc:Loc CancelButton}" Style="{StaticResource ToolButton}" Click="CancelButton_Click" />
                <Button x:Name="RetryButton" Content="{loc:Loc RetryButton}" Style="{StaticResource ToolButton}" Click="RetryButton_Click" />
                <Button x:Name="RemoveButton" Content="{loc:Loc RemoveButton}" Style="{StaticResource ToolButton}" Click="RemoveButton_Click" />
                <Button x:Name="OpenFileButton" Content="{loc:Loc OpenFileButton}" Style="{StaticResource ToolButton}" Click="OpenFileButton_Click" />
                <Button x:Name="OpenFolderButton" Content="{loc:Loc OpenFolderButton}" Style="{StaticResource ToolButton}" Click="OpenFolderButton_Click" />
                <Button x:Name="CopyDetailsButton" Content="{loc:Loc CopyDetailsButton}" Style="{StaticResource ToolButton}" Click="CopyDetailsButton_Click" />
                <Button x:Name="ClearCompletedButton" Content="{loc:Loc ClearCompletedButton}" Style="{StaticResource ToolButton}" Click="ClearCompletedButton_Click" />
            </WrapPanel>
            <WrapPanel Grid.Column="1">
                <TextBox x:Name="SearchTextBox"
                         Width="170"
                         Height="34"
                         Margin="0,0,7,0"
                         Style="{StaticResource InputBox}"
                         ToolTip="{loc:Loc SearchWatermark}"
                         TextChanged="SearchTextBox_TextChanged" />
                <Button Content="{loc:Loc PauseAllButton}" Style="{StaticResource ToolButton}" Click="PauseAllButton_Click" />
                <Button Content="{loc:Loc ResumeAllButton}" Style="{StaticResource ToolButton}" Margin="0" Click="ResumeAllButton_Click" />
            </WrapPanel>
        </Grid>

        <!-- Queue and details -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="4">
                <Grid>
                    <DataGrid x:Name="JobsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              AlternationCount="2"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2F7"
                              VerticalGridLinesBrush="Transparent"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              RowHeight="44"
                              EnableRowVirtualization="True"
                              SelectionChanged="JobsGrid_SelectionChanged"
                              MouseDoubleClick="JobsGrid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="JobsGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc OpenFileButton}" Click="ContextOpenFile_Click" />
                                <MenuItem Header="{loc:Loc OpenFolderButton}" Click="ContextOpenFolder_Click" />
                                <Separator />
                                <MenuItem Header="{loc:Loc CopyUrlButton}" Click="ContextCopyUrl_Click" />
                                <MenuItem Header="{loc:Loc EditUrlButton}" Click="ContextEditUrl_Click" />
                                <MenuItem Header="{loc:Loc CopyDetailsButton}" Click="ContextCopyDetails_Click" />
                                <Separator />
                                <MenuItem Header="{loc:Loc RetryButton}" Click="ContextRetry_Click" />
                                <MenuItem Header="{loc:Loc CancelButton}" Click="ContextCancel_Click" />
                                <MenuItem Header="{loc:Loc RemoveButton}" Click="ContextRemove_Click" />
                                <MenuItem Header="{loc:Loc DeleteFileButton}" Click="ContextDeleteFile_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="FileColumn"
                                                Header="{loc:Loc ColumnFile}"
                                                Binding="{Binding FileName}"
                                                Width="2*"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn x:Name="SizeColumn"
                                                Header="{loc:Loc ColumnSize}"
                                                Binding="{Binding SizeText}"
                                                Width="86"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn x:Name="ProgressColumn" Header="{loc:Loc ColumnProgress}" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Style="{StaticResource SlimProgress}"
                                                         Maximum="100"
                                                         Value="{Binding Percentage, TargetNullValue=0}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressText}"
                                                       FontSize="12"
                                                       Foreground="#475569"
                                                       MinWidth="42"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="SpeedColumn"
                                                Header="{loc:Loc ColumnSpeed}"
                                                Binding="{Binding SpeedText}"
                                                Width="96"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn x:Name="EtaColumn"
                                                Header="{loc:Loc ColumnEta}"
                                                Binding="{Binding EtaText}"
                                                Width="76"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn x:Name="ConnectionsColumn"
                                                Header="{loc:Loc ColumnConnections}"
                                                Binding="{Binding ConnectionCount}"
                                                Width="86"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn x:Name="BufferColumn"
                                                Header="{loc:Loc ColumnBuffer}"
                                                Binding="{Binding BufferModeText}"
                                                Width="82"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn x:Name="StatusColumn" Header="{loc:Loc ColumnStatus}" Width="108">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource StatusCell}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{loc:Loc NoDownloadsYet}"
                               Foreground="{StaticResource SubtleBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,34,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=JobsGrid}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource SurfaceCard}"
                    Margin="0,10,0,0"
                    Padding="16,12"
                    DataContext="{Binding SelectedItem, ElementName=JobsGrid}">
                <Grid>
                    <Grid x:Name="DetailsContentGrid" Style="{StaticResource DetailsContent}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="3"
                                   Text="{loc:Loc DetailsTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="{loc:Loc SourceLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding SourceUri}"
                                   Foreground="#334155"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <TextBlock Grid.Row="2" Text="{loc:Loc TargetLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding TargetPath}"
                                   Foreground="#334155"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <StackPanel Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    Margin="0,2,0,4">
                            <TextBlock Foreground="#64748B" FontSize="12">
                                <Run Text="{loc:Loc ConnectionsDetailLabel}" FontWeight="SemiBold" />
                                <Run Text=": " />
                                <Run Text="{Binding ConnectionCount}" />
                            </TextBlock>
                            <TextBlock Foreground="#64748B" FontSize="12" Margin="18,0,0,0">
                                <Run Text="{loc:Loc SegmentsLabel}" FontWeight="SemiBold" />
                                <Run Text=": " />
                                <Run Text="{Binding SegmentCount}" />
                            </TextBlock>
                            <TextBlock Foreground="#64748B" FontSize="12" Margin="18,0,0,0">
                                <Run Text="{loc:Loc ColumnBuffer}" FontWeight="SemiBold" />
                                <Run Text=": " />
                                <Run Text="{Binding BufferModeText}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="4"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding ErrorDetailsText}"
                                   Style="{StaticResource ErrorText}" />
                    </Grid>

                    <TextBlock Text="{loc:Loc DetailsEmpty}"
                               Foreground="{StaticResource SubtleBrush}"
                               FontSize="12"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="4,6"
                BorderThickness="0"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageTextBlock"
                           Text="{loc:Loc ReadyStatus}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ActiveSummaryTextBlock"
                           Grid.Column="1"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SpeedSummaryTextBlock"
                           Grid.Column="2"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionSummaryTextBlock"
                           Grid.Column="3"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="5"
              Background="#8C0F172A"
              Visibility="Collapsed"
              Margin="-22">
            <Border Width="620"
                    MaxHeight="700"
                    Background="White"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Loc SettingsTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="{loc:Loc CloseSettingsButton}"
                                Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Right"
                                Click="CloseSettingsButton_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc DownloadFolderLabel}" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderTextBox" Style="{StaticResource InputBox}" />
                                <Button Grid.Column="1"
                                        Content="{loc:Loc BrowseButton}"
                                        Style="{StaticResource ToolButton}"
                                        Margin="8,0,0,0"
                                        Click="BrowseFolderButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{loc:Loc ConnectionsLabel}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ConnectionsComboBox" Height="34">
                                        <ComboBoxItem Tag="0" Content="{loc:Loc ConnectionsAuto}" />
                                        <ComboBoxItem Tag="1" Content="1" />
                                        <ComboBoxItem Tag="2" Content="2" />
                                        <ComboBoxItem Tag="4" Content="4" />
                                        <ComboBoxItem Tag="8" Content="8" />
                                        <ComboBoxItem Tag="16" Content="16" />
                                        <ComboBoxItem Tag="32" Content="32" />
                                        <ComboBoxItem Tag="64" Content="64" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{loc:Loc ConcurrentLabel}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ConcurrentComboBox" Height="34">
                                        <ComboBoxItem Tag="1" Content="1" />
                                        <ComboBoxItem Tag="2" Content="2" />
                                        <ComboBoxItem Tag="3" Content="3" />
                                        <ComboBoxItem Tag="4" Content="4" />
                                        <ComboBoxItem Tag="6" Content="6" />
                                        <ComboBoxItem Tag="8" Content="8" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{loc:Loc BufferModeLabel}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="BufferModeComboBox" Height="34" Margin="0,0,0,14">
                                <ComboBoxItem Tag="Auto" Content="{loc:Loc BufferAuto}" />
                                <ComboBoxItem Tag="LowRam" Content="{loc:Loc BufferLowRam}" />
                                <ComboBoxItem Tag="Balanced" Content="{loc:Loc BufferBalanced}" />
                                <ComboBoxItem Tag="Fast" Content="{loc:Loc BufferFast}" />
                            </ComboBox>

                            <TextBlock Text="{loc:Loc PerHostLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PerHostTextBox" Style="{StaticResource InputBox}" Margin="0,0,0,14" />

                            <TextBlock Text="{loc:Loc SpeedLimitLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SpeedLimitTextBox" Style="{StaticResource InputBox}" Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Loc SpeedLimitHint}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,14"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="DynamicSegmentationCheckBox"
                                      Content="{loc:Loc DynamicSegmentationLabel}"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,2" />
                            <TextBlock Text="{loc:Loc DynamicSegmentationHint}"
                                       Style="{StaticResource MutedText}"
                                       Margin="24,0,0,10"
                                       TextWrapping="Wrap" />

                            <CheckBox x:Name="AutoResumeCheckBox"
                                      Content="{loc:Loc AutoResumeLabel}"
                                      Margin="0,0,0,8" />
                            <CheckBox x:Name="ConfirmExternalCheckBox"
                                      Content="{loc:Loc ConfirmExternalLabel}"
                                      Margin="0,0,0,14" />

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E7ECF3"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="{loc:Loc RegisterBrowserButton}"
                                                Style="{StaticResource ToolButton}"
                                                Click="RegisterProtocolButton_Click" />
                                        <Button Content="{loc:Loc OpenLogsButton}"
                                                Style="{StaticResource ToolButton}"
                                                Click="OpenLogsButton_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="{loc:Loc AboutText}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="{loc:Loc CloseSettingsButton}"
                                Style="{StaticResource ToolButton}"
                                Click="CloseSettingsButton_Click" />
                        <Button Content="{loc:Loc SaveSettingsButton}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0"
                                Click="SaveSettingsButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
